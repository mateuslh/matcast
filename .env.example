# Duplique este arquivo como .env e preencha com os dados da camera.
CAMERA_HOST=192.168.1.5
CAMERA_PORT=554
CAMERA_USER=admin
CAMERA_PASSWORD=troque-aqui

# Use "auto" para testar os caminhos mais comuns, ou informe um caminho exato.
# Exemplos:
# Intelbras/Dahua: /cam/realmonitor?channel=1&subtype=0
# Hikvision:       /Streaming/Channels/101
# Generica:        /stream1
CAMERA_RTSP_PATH=auto

# Use 1 somente se a camera transmitir H.265 ou o navegador nao reproduzir.
CAMERA_TRANSCODE=0
PORT=8080
